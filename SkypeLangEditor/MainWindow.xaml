<Window x:Class="SkypeLangEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skype .lang Translation Editor" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Height="25">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="MenuNew_Click"/>
                <MenuItem Header="_Open..." Click="MenuOpen_Click"/>
                <Separator/>
                <MenuItem Header="_Save" Click="MenuSave_Click"/>
                <MenuItem Header="Save _As..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Add New _Entry" Click="MenuAddEntry_Click"/>
                <MenuItem Header="_Delete Selected Entry" Click="MenuDeleteEntry_Click"/>
                <Separator/>
                <MenuItem Header="Sort Entries Alphabetically" Click="MenuSortEntries_Click"/>
            </MenuItem>
            <MenuItem Header="_Template">
                <MenuItem Header="Apply Template to Active File..." Click="MenuApplyTemplateToFile_Click"/>
                <MenuItem Header="Apply Template to Directory..." Click="MenuApplyTemplateToDirectory_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatsText" Text="Total Entries: 0 | Filtered: 0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search and Replace Section -->
            <GroupBox Header="Search &amp; Replace / Filter" Grid.Row="0" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: Search and Replace Inputs -->
                    <TextBlock Text="Find:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,8,6"/>
                    <TextBox x:Name="SearchTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,15,6" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock Text="Replace:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6"/>
                    <TextBox x:Name="ReplaceTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" VerticalContentAlignment="Center"/>

                    <!-- Row 2: Controls & Toggles -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="0,4,0,0">
                        <CheckBox x:Name="RegexCheckBox" Content="Use Regex" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="MatchCaseCheckBox" Content="Match Case" Margin="0,0,15,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                        <ComboBox x:Name="ScopeComboBox" Width="100" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="Both"/>
                            <ComboBoxItem Content="Key Only"/>
                            <ComboBoxItem Content="Value Only"/>
                        </ComboBox>

                        <Button x:Name="ReplaceAllButton" Content="Replace All" Margin="20,0,8,0" Padding="12,3" Click="ReplaceAllButton_Click"/>
                        <Button x:Name="ClearFilterButton" Content="Clear Search" Padding="10,3" Click="ClearFilterButton_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- DataGrid Section -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Toolbar -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5">
                    <Button Content="Add Entry" Padding="10,3" Margin="0,0,5,0" Click="MenuAddEntry_Click"/>
                    <Button Content="Delete Selected" Padding="10,3" Margin="0,0,5,0" Click="MenuDeleteEntry_Click"/>
                    <Button Content="Sort A-Z" Padding="10,3" Margin="0,0,5,0" Click="MenuSortEntries_Click"/>
                </StackPanel>

                <!-- Key Value Grid -->
                <DataGrid x:Name="EntriesDataGrid" Grid.Row="1" AutoGenerateColumns="False"
                          CanUserAddRows="True" CanUserDeleteRows="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          SelectionMode="Extended" RowHeaderWidth="25"
                          CellEditEnding="EntriesDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
